<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_universal_approval" model="ir.ui.view">
        <field name="name">sale.order.universal.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-primary" invisible="approval_status in ['pending', 'approved']"/>
                <button name="action_approve_document" string="Approve" type="object" class="btn-success" invisible="approval_status != 'pending'"/>
                <button name="action_reject_document" string="Reject" type="object" class="btn-danger" invisible="approval_status != 'pending'"/>
            </header>
            <sheet position="inside">
                <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible="approval_status != 'approved'"/>
                <widget name="web_ribbon" title="Rejected" bg_color="bg-danger" invisible="approval_status != 'rejected'"/>
            </sheet>
            <field name="state" position="before">
                <field name="approval_status" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>