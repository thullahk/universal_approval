<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_universal_approval_form" model="ir.ui.view">
        <field name="name">universal.approval.form</field>
        <field name="model">universal.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" states="pending" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject" states="pending"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="res_reference"/>
                        <field name="requested_by_id"/>
                        <field name="approved_by_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>